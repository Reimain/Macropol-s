{
  "name": "Macropol-s — SLPIE and Gratimos",

  // 3.11 is the floor, and the floor is what CI runs first. Developing on a
  // newer interpreter than the one that gates the build is how a 3.12-only
  // syntax reaches main.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "features": {
    // The discovery layer shells out to git for repository history, and the
    // simulator materialises a real git repository with a real commit. Without
    // git those paths report a capability gap rather than failing — but the
    // notebooks are more interesting when they do not have to.
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "jupyter.notebookFileRoot": "${workspaceFolder}/notebooks",
        "[python]": {
          "editor.rulers": [84]
        }
      }
    }
  },

  "forwardPorts": [8888, 8765],
  "portsAttributes": {
    "8888": { "label": "JupyterLab", "onAutoForward": "openBrowser" },
    "8765": { "label": "slpie ui", "onAutoForward": "notify" }
  },

  "remoteUser": "vscode"
}
